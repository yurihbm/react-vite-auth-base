{
	"name": "react-vite-auth-base",
	"private": true,
	"version": "0.0.0",
	"type": "module",
	"scripts": {
		"build": "tsc -b && vite build",
		"build-storybook": "storybook build",
		"dev": "vite",
		"format": "oxfmt",
		"i18n": "i18next-cli extract && i18next-cli types",
		"i18n:watch": "i18next-cli extract --watch",
		"i18n:types": "i18next-cli types",
		"lighthouse": "node scripts/lighthouse.js",
		"lint": "oxlint -c oxlint.config.ts .",
		"prepare": "node .husky/install.mjs",
		"rename": "node scripts/rename/main.ts",
		"preview": "vite preview",
		"storybook": "storybook dev -p 6006",
		"test": "vitest run",
		"test:ci": "vitest run --bail 1",
		"test:coverage": "vitest run --coverage",
		"test:watch": "vitest",
		"typecheck": "tsc -b"
	},
	"dependencies": {
		"@phosphor-icons/react": "^2.1.10",
		"@tailwindcss/vite": "^4.3.5",
		"@tanstack/react-query": "^5.108.4",
		"@tanstack/react-query-devtools": "^5.108.4",
		"@tanstack/react-router": "^1.170.46",
		"@tanstack/react-router-devtools": "^1.167.4",
		"@tanstack/react-table": "^9.3.1",
		"@tanstack/react-virtual": "^3.14.28",
		"i18next": "^27.2.9",
		"i18next-browser-languagedetector": "^8.3.1",
		"i18next-http-backend": "^4.1.2",
		"react": "^19.3.1",
		"react-dom": "^19.3.1",
		"react-i18next": "^18.0.3",
		"recharts": "^3.11.1",
		"tailwind-variants": "^4.0.2",
		"tailwindcss": "^4.3.5",
		"zod": "^4.6.7"
	},
	"devDependencies": {
		"@babel/core": "^8.1.3",
		"@rolldown/plugin-babel": "^0.3.1",
		"@storybook/addon-a11y": "^10.6.9",
		"@storybook/addon-docs": "^10.6.9",
		"@storybook/addon-vitest": "^10.6.9",
		"@storybook/react-vite": "^10.6.9",
		"@tanstack/eslint-plugin-query": "^5.108.4",
		"@tanstack/router-plugin": "^1.169.0",
		"@testing-library/dom": "^10.4.2",
		"@testing-library/react": "^16.3.3",
		"@types/babel__core": "^7.20.5",
		"@types/node": "^26.6.10",
		"@types/react": "^19.3.3",
		"@types/react-dom": "^19.3.0",
		"@typescript/native": "npm:typescript@^7.0.2",
		"@vitejs/plugin-react": "6.3.0",
		"@vitest/browser-playwright": "5.1.2",
		"@vitest/coverage-v8": "5.1.2",
		"babel-plugin-react-compiler": "^1.0.0",
		"eslint-plugin-storybook": "^10.6.9",
		"happy-dom": "^21.0.4",
		"husky": "^9.1.7",
		"i18next-cli": "^1.95.3",
		"lighthouse": "^13.6.0",
		"lint-staged": "^17.6.2",
		"open": "^11.0.4",
		"oxfmt": "^0.80.0",
		"oxlint": "^1.95.0",
		"playwright": "^1.65.1",
		"storybook": "^10.6.9",
		"typescript": "npm:@typescript/typescript6@~6.0.2",
		"vite": "8.3.8",
		"vite-plugin-pwa": "^2.0.0",
		"vitest": "^5.1.2"
	},
	"lint-staged": {
		"*.{ts,tsx}": [
			"oxlint -c oxlint.config.ts --fix",
			"oxfmt --no-error-on-unmatched-pattern"
		],
		"*.{css,json,md,yaml,yml}": [
			"oxfmt --no-error-on-unmatched-pattern"
		]
	},
	"packageManager": "pnpm@12.23.0+sha512.02da94ffaf133f46074322afe552f90d40b5f71ae259aefbccdacc5085b1d617e98d65e0131f5748b9b67445978ee5055d7d59a473f1eef0d504854fefcd5975",
	"engines": {
		"node": ">=24"
	}
}
